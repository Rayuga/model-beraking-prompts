# Harbor scripts must remain executable by Linux containers even when the
# repository is checked out on Windows with core.autocrlf enabled.
.gitattributes text eol=lf
projects/dropline-four-lite/**/*.sh text eol=lf
projects/brickfall-breaker-arcade/**/*.sh text eol=lf

# Keep the complete DropLine task definition reproducible across Windows and
# Linux without treating its XLSX seed or packaged ZIP as text.
projects/dropline-four-lite/**/Dockerfile text eol=lf
projects/dropline-four-lite/**/*.md text eol=lf
projects/dropline-four-lite/**/*.toml text eol=lf
projects/dropline-four-lite/**/*.json text eol=lf
projects/dropline-four-lite/**/*.js text eol=lf
projects/dropline-four-lite/**/*.html text eol=lf
projects/dropline-four-lite/**/*.css text eol=lf
reports/dropline-four-lite/**/*.md text eol=lf
reports/dropline-four-lite/**/*.json text eol=lf
