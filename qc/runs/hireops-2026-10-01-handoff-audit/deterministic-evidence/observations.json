        "recruiting",
        "compensation",
        "ledger",
        "webdev",
        "turing",
        "full-stack"
      ]
    },
    "metadata": {
      "difficulty": "hard",
      "difficulty_explanation": "Closely related compensation totals feed different decisions. Correct implementations preserve exact rounding, UTC calendar boundaries, current-leaf budget replacement, signed payment adjustments, historical equity grants, referral provenance, and atomic refusal under stale or competing requests. Each useful outcome receives independent credit.",
      "category": "programming",
      "tags": [
        "full-stack",
        "browser",
        "arena",
        "rl-training"
      ],
      "provenance": "Adapted from the supplied HireOps task with clarified lifecycle rules and an authored reference implementation and browser rubric.",
