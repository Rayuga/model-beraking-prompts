+stop_app_group() {
+  timeout 8 python3 - "$1" <<'PY'
+import os
+from pathlib import Path
+import signal
+import sys
+import time
+
+pid = int(sys.argv[1])
+if pid <= 1:
+    sys.exit("invalid application process group")
+
+def running():
+    for entry in Path("/proc").glob("[0-9]*/stat"):
+        try:
+            fields = entry.read_text().rsplit(")", 1)[1].split()
+            if int(fields[2]) == pid and fields[0] not in ("Z", "X"):
+                return True
+        except (FileNotFoundError, ProcessLookupError):
+            continue
+    return False
+
+for sig, grace in ((signal.SIGTERM, 5), (signal.SIGKILL, 1)):
+    if not running():
+        sys.exit(0)
+    try:
+        os.killpg(pid, sig)
+    except ProcessLookupError:
+        sys.exit(0)
+    deadline = time.monotonic() + grace
+    while time.monotonic() < deadline:
+        if not running():
+            sys.exit(0)
+        time.sleep(0.1)
+sys.exit("application process group did not terminate")
+PY
+}
+
