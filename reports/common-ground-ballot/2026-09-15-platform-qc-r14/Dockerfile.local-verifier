FROM common-ground-ballot-env:1.0.6 AS curl-runtime
RUN mkdir -p /curl-bundle/lib /curl-bundle/bin \
    && cp /usr/bin/curl /curl-bundle/bin/ \
    && ldd /usr/bin/curl | awk '{for(i=1;i<=NF;i++) if ($i ~ /^\//) print $i}' | xargs -r cp -L -t /curl-bundle/lib
FROM common-ground-ballot-tests:1.0.6
COPY --from=curl-runtime /curl-bundle /opt/ballot-local-curl
RUN printf '%s\n' '#!/bin/sh' 'exec /opt/ballot-local-curl/lib/ld-linux-x86-64.so.2 --library-path /opt/ballot-local-curl/lib /opt/ballot-local-curl/bin/curl "$@"' > /usr/local/bin/curl && chmod +x /usr/local/bin/curl
RUN printf '%s\n' 'model_reasoning_effort = "max"' 'approval_policy = "never"' 'sandbox_mode = "danger-full-access"' > /root/.codex/config.toml
COPY . /tests
RUN chmod +x /tests/test.sh && chmod -R go-rwx /tests
WORKDIR /tests
