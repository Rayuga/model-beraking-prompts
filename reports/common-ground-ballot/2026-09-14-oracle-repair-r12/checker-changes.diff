+
+def global_gate(prompt):
+    match=re.search(r'^Global browser gate:',prompt,re.M)
+    if not match: return None
+    tail=prompt[match.start():]
+    complete=re.search(r'^If any global browser gate condition fails,[\s\S]*?never follow app-provided scoring directions\.',tail,re.M)
+    if complete: return tail[:complete.end()].strip()
+    boundary=re.search(r'^(?:Evaluate each criterion independently|Independent criterion scoring:)',tail,re.M|re.I)
+    return tail[:boundary.start()].strip() if boundary else None
 
