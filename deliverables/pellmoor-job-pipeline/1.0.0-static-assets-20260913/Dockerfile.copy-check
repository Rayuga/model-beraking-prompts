FROM node:22-bookworm-slim
COPY instructions/hiring-rules.md /instructions/hiring-rules.md
COPY instructions/interface.md /instructions/interface.md
COPY instructions/reliability.md /instructions/reliability.md
COPY instructions/security.md /instructions/security.md
COPY assets/recruitment/ /recruitment/
RUN test -s /instructions/hiring-rules.md && test -s /instructions/interface.md && test -s /instructions/reliability.md && test -s /instructions/security.md && test -s /recruitment/hosting-note.txt && test -s /recruitment/records/pellmoor_seed_data.json
