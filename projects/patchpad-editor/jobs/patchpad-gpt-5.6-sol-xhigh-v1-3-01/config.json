{
    "job_name": "patchpad-gpt-5.6-sol-xhigh-v1-3-01",
    "jobs_dir": "projects\\patchpad-editor\\jobs",
    "n_concurrent_trials": 1,
    "retry": {
        "max_retries": 3,
        "include_exceptions": [
            "NetworkConnectionError"
        ]
    },
    "verifier": {
