            "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}"
        }
    },
    "agents": [
        {
            "name": "openhands",
            "model_name": "openrouter/openai/gpt-5.6-sol",
            "kwargs": {
                "reasoning_effort": "xhigh",
                "version": "0.62.0"
            },
            "env": {
                "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}"
            }
        }
    ],
    "tasks": [
        {
            "path": "projects\\patchpad-editor\\patchpad-editor"
        }
    ]
}